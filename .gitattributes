# Script de shell tem de chegar com LF em qualquer máquina: com CRLF, o `\r`
# entra no shebang e o sistema procura um interpretador "bash\r".
*.sh text eol=lf
*.ps1 text eol=crlf

# O hook do git não tem extensão, mas é script de shell: LF obrigatório.
testes/hooks/* text eol=lf

# Binários: nunca converter fim de linha (um PDF com CRLF trocado quebra)
*.pdf binary
*.cbz binary
*.cbr binary
*.zip binary
*.woff2 binary
*.png binary
*.jpg binary
*.mp4 binary
